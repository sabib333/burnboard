# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Developer Platform (Master Prompt 20)
# PLATFORM_WEBHOOK_PEPPER: server-side secret used to derive webhook signing
# keys (HMAC over the stored secret hash). Change it in production and
# regenerate app credentials; developers derive the same key with their
# plaintext secret. Never commit the real value.
PLATFORM_WEBHOOK_PEPPER="change-me-strong-random"

# Admin gate (Master Prompt 26)
# ADMIN_PASSWORD: the shared secret protecting /admin, /admin/growth,
# /admin/financials, /admin/infrastructure, /admin/security and the
# /api/admin/* + /api/growth/* management endpoints. The gate FAILS CLOSED:
# if this is unset, every admin surface returns 503 (admin_not_configured)
# — there is no default. Generate a strong random value (e.g. openssl rand
# -base64 32) and never commit it. Set it in every environment including
# local development, or the admin dashboards will refuse to unlock.
ADMIN_PASSWORD="generate-a-long-random-value"

# CRON_SECRET: bearer secret for the scheduled endpoints (/api/cron/*,
# plus /api/growth/analytics + /api/growth/alerts + /api/admin/financials
# when called from ops dashboards). Endpoints fail closed (401) when unset.
CRON_SECRET="generate-a-second-long-random-value"
