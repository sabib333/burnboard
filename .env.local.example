# BURNBOARD Environment Variables
# Copy to .env.local for local development or set in Vercel Project Settings

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SITE_URL=https://burnboard.app

